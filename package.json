{
  "name": "savira-client",
  "version": "0.1.6",
  "description": "Savira Minecraft Launcher und PvP HUD",
  "author": "Savira",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "prebuild": "node scripts/create-icon.mjs",
    "build": "tsc --noEmit && vite build",
    "build:mod": "node scripts/build-mod.mjs",
    "start": "electron .",
    "dist": "npm run build:mod && npm run build && electron-builder --win portable --publish never",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:game": "node scripts/test-game.mjs",
    "test:package": "node scripts/test-package.mjs",
    "dev:setup": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev --setup\"",
    "release": "npm run dist && node scripts/release.mjs manifest",
    "release:keygen": "node scripts/release.mjs keygen",
    "test:update": "node scripts/test-update.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "msmc": "^5.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "gg.savira.launcher",
    "productName": "Savira",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "client-mod/build/libs/savira-client-0.1.0.jar",
        "to": "mods/savira-client-0.1.0.jar"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "portable": {
      "artifactName": "Savira-Setup-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  },
  "saviraUpdate": {
    "github": "CuniixOT/Saviraclient",
    "feed": "",
    "publicKey": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA8tupHLGMDEUZM6PC9Y/AWVAWAb9q12Z4Ge5ia1EoT5Q=\n-----END PUBLIC KEY-----\n"
  },
  "saviraLinks": {
    "discord": ""
  }
}
